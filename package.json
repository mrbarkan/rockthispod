{
  "name": "macrockpod-installer",
  "version": "1.0.0",
  "description": "MacRockPod Installer for Apple Silicon Macs",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node test/geometry.test.js && node test/logo.test.js",
    "package": "electron-packager . MacRockPod --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=com.macrockpod.installer --app-version=1.0.0 --app-category-type=public.app-category.utilities --icon=build/icon.icns --ignore=\"^/rockbox-src\" --ignore=\"^/dist\" --ignore=\"^/build\" --ignore=\"^/test\" --ignore=\"^/repair-\" --ignore=\"\\.md$\" --ignore=\"\\.DS_Store$\"",
    "dist": "bash build/notarize.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-packager": "^17.1.2"
  }
}
